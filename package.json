{
  "name": "localtaste",
  "version": "0.1.0",
  "private": true,
  "description": "A taste advisor for independent caf\u00e9s and restaurants, powered by Qloo neighbourhood affinities.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p infra/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "check:core": "node scripts/check-core.ts",
    "deploy": "cdk deploy localtaste",
    "deploy:web": "scripts/deploy-web.sh"
  },
  "dependencies": {
    "@qloo/qloo-harness": "^0.1.26",
    "aws-amplify": "^6.22.2"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-geo-places": "^3.1157.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1158.0",
    "@aws-sdk/credential-provider-node": "^3.972.89",
    "@aws-sdk/credential-providers": "^3.1157.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.25.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "vite": "^6.4.5"
  }
}
