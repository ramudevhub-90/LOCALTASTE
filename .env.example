# Secrets are NOT read from .env. The Qloo key is an SSM SecureString that the
# worker reads at cold start:
#   read -rs "K?Qloo key: " && aws ssm put-parameter --name /localtaste/qloo-api-key --type SecureString --overwrite --value "$K"; unset K
# Use the AWS profile that holds the account:
#   AWS_PROFILE=default AWS_REGION=us-east-1
